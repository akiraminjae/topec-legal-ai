# ============================================================
# TOPEC Legal AI - 환경변수 예시
# 이 파일을 복사하여 .env로 만든 뒤 실제 값으로 채우세요.
# 절대 실제 비밀번호/API 키를 이 파일(.env.example)에 커밋하지 마세요.
# ============================================================

# ---- App ----
ENVIRONMENT=development
TIMEZONE=Asia/Seoul
SECRET_KEY=change-me-to-a-random-64-char-string
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000

# ---- Ports (충돌 시 변경) ----
WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Database ----
POSTGRES_USER=topec
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=topec_legal_ai
DATABASE_URL=postgresql+psycopg://topec:change-me-postgres-password@postgres:5432/topec_legal_ai

# ---- Redis ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- MinIO (S3 호환 파일저장) ----
MINIO_ROOT_USER=topec_minio
MINIO_ROOT_PASSWORD=change-me-minio-password
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=topec_minio
S3_SECRET_KEY=change-me-minio-password
S3_BUCKET=topec-legal-documents
S3_USE_SSL=false

# ---- Auth ----
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ---- 회원가입 (이메일 인증) ----
# 콤마로 구분된 허용 회사 이메일 도메인. 비워두면 모든 도메인 가입 허용.
SIGNUP_ALLOWED_EMAIL_DOMAINS=topec.co.kr
SIGNUP_VERIFICATION_TOKEN_TTL_HOURS=24
# 인증 메일의 링크에 사용되는 프론트엔드 공개 주소(마지막 슬래시 없이)
APP_PUBLIC_URL=http://localhost:3000

# ---- Resend (회원가입 인증 메일 발송, resend.com에서 API 키 발급) ----
# 설정되어 있으면 SMTP보다 우선 사용됨(클라우드 사업자가 SMTP 포트를 막아도 정상 동작).
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@topecai.co.kr

# ---- SMTP (Resend 미설정 시 대체 발송 경로) ----
# 둘 다 비워두면 실제 발송 대신 서버 로그에 인증 링크를 출력합니다(개발용).
SMTP_HOST=
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=TOPEC Legal AI

# ---- AI Provider ----
# mock | anthropic | openai | azure_openai | gemini | local
# API 키가 없으면 mock으로 두세요. Mock 모드에서도 전체 업무흐름을 테스트할 수 있습니다.
# AI_MODEL 기본값 예시: anthropic=claude-sonnet-5, openai=gpt-4o, gemini=gemini-flash-latest,
# azure_openai=배포명(deployment name)
AI_PROVIDER=mock
AI_MODEL=claude-sonnet-5
AI_API_KEY=
AI_BASE_URL=
AI_REQUEST_TIMEOUT=180
AI_MAX_TOKENS=16000
LOCAL_MODEL_ENDPOINT=

# ---- 임베딩 (RAG) ----
EMBEDDING_PROVIDER=mock
EMBEDDING_DIM=384

# ---- 파일 업로드 ----
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,docx,hwpx,hwp,txt

# ---- LibreOffice 변환 서비스 ----
LIBREOFFICE_BASE_URL=http://libreoffice:2004

# ---- 바이러스 검사 (미설정 시 "검사 미구성" 상태로 표시) ----
CLAMAV_HOST=
CLAMAV_PORT=3310

# ---- 법률정보 연계: API 유형별로 분리 ----
# 1) 공공데이터포털(data.go.kr) — 법제처 국가법령정보 공유서비스: 법령·행정규칙 목록/메타정보
#    https://www.data.go.kr 에서 "법제처_국가법령정보 공동활용" 활용신청 후 발급되는
#    서비스키 중 "디코딩(Decoding)" 버전을 입력하세요(인코딩 버전을 넣으면 이중 인코딩되어 실패).
PUBLIC_DATA_SERVICE_KEY=
# 2) 국가법령정보 공동활용 LINK API — law.go.kr DRF, 판례 목록/본문 + 법령 상세본문(조문)
#    https://open.law.go.kr 에서 발급받는 OC를 입력하세요.
OPEN_LAW_OC=
# 두 키 모두 비워두면 외부 법령·판례 조회를 건너뛰고 내부 지식베이스만 사용합니다(분석은 정상 동작).
EXTERNAL_LEGAL_RATE_LIMIT_PER_MINUTE=30

# ---- 소송·분쟁 사건(LegalCase) 다중 PDF 일괄 업로드 제한 ----
LITIGATION_BATCH_MAX_FILES=100
LITIGATION_BATCH_MAX_TOTAL_SIZE_MB=1000
LITIGATION_SINGLE_FILE_MAX_SIZE_MB=200
LITIGATION_MAX_PAGES_PER_FILE=2000
LITIGATION_PARALLEL_PROCESSING_COUNT=3

# ---- 초기 시드 계정 (개발용, 최초 로그인 시 비밀번호 변경 강제) ----
SEED_ADMIN_EMAIL=admin@topec.local
SEED_ADMIN_PASSWORD=ChangeMe1234!
SEED_LEGAL_EMAIL=legal@topec.local
SEED_LEGAL_PASSWORD=ChangeMe1234!
SEED_USER_EMAIL=user@topec.local
SEED_USER_PASSWORD=ChangeMe1234!

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# 카카오톡 공유 기능용 JavaScript 키. https://developers.kakao.com 에서 앱 등록 후
# "내 애플리케이션 > 앱 키 > JavaScript 키"를 발급받아 입력하세요(직접 신청 필요).
# 비워두면 공유하기 메뉴의 카카오톡 공유 항목이 비활성화 상태로 표시됩니다.
# NEXT_PUBLIC_*는 빌드 타임에 반영되므로 값 변경 후 `docker compose build web`이 필요합니다.
NEXT_PUBLIC_KAKAO_JS_KEY=
