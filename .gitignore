.env
.env.local

# Python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node / Next.js
node_modules/
.next/
out/
next-env.d.ts

# Editors / OS
.vscode/
.idea/
